# OpenMower mode environment
# This file controls the specific mode settings like logging and debug behavior of openmower.service.
#
# Set OM_MODE to "normal" for SD-friendly operation (minimal logging, no ROS file logs).
# Set OM_MODE to "debug" for full debug logging and ROS file logs.
#
# Example:
#   OM_MODE=normal   # SD-friendly, production mode
#   OM_MODE=debug    # Debug mode, logs everything

OM_MODE=normal